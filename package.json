{
	"name": "ivy-vaults",
	"private": true,
	"license": "BUSL-1.1",
	"version": "0.1.0",
	"description": "Ivy option vaults: IvyVaultsHub + minimal IvyVault clones",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"compile": "hardhat compile",
		"test": "hardhat test",
		"coverage": "hardhat test --coverage",
		"typecheck": "tsc --noEmit",
		"check:size": "node scripts/check-size.ts",
		"postcompile": "node scripts/check-size.ts",
		"docs:check": "node scripts/check-docs.ts",
		"docs:build": "node scripts/build-docs.ts",
		"docs:test": "node --test --test-concurrency=1 \"docs/site/test/*.test.mjs\"",
		"format": "prettier --write \"**/*.ts\"",
		"format:check": "prettier --check \"**/*.ts\""
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-ethers": "^4.0.15",
		"@nomicfoundation/hardhat-ignition": "^3.1.8",
		"@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
		"@openzeppelin/contracts": "^5.6.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/chai": "^5.2.3",
		"@types/chai-as-promised": "^8.0.1",
		"@types/mocha": ">=10.0.10",
		"@types/node": "^22.8.5",
		"chai": "^6.2.2",
		"ethers": "^6.14.0",
		"hardhat": "^3.15.0",
		"husky": "^9.1.7",
		"marked": "^18.0.12",
		"mocha": "^11.0.0",
		"playwright": "^1.63.0",
		"prettier": "3.9.9",
		"prettier-plugin-solidity": "^2.4.1",
		"typescript": "~6.0.3"
	}
}

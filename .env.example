# Copy to .env and fill in these two values. Never commit that file.
POLYGON_RPC=
IVY_DEPLOYER=

# Network URLs and accounts are configured in hardhat.config.ts.
# Defaults to deployments/local/<network name>; set a different directory for a new run.
DEPLOY_DIR=
DEPLOY_CONFIRMATIONS=1
DEPLOY_TX_TIMEOUT_MS=120000
# Upper limits, in gwei. Fees are estimated from the RPC when signing.
DEPLOY_MAX_FEE_GWEI=500
DEPLOY_MAX_PRIORITY_FEE_GWEI=100

# Blank addresses default to the deployer. Admin and treasury are the deployer.
DEPLOY_REPORT_SIGNER=
DEPLOY_BID_MASTER=
DEPLOY_MARKET_MAKER=
DEPLOY_SETTLEMENT_PUBLISHER=
DEPLOY_TOKEN_RECIPIENT=

# Test defaults, in seconds. Saved in plan.json at planning time.
DEPLOY_EXERCISE_WINDOW=3600
DEPLOY_PUBLICATION_WINDOW=3600
DEPLOY_AUCTION_TIMEOUT=3600
DEPLOY_CASH_SETTLEMENT=true
DEPLOY_TRANSFERS_ENABLED=true
DEPLOY_URI=

# Whole-token quantities, not smallest units. Minted once by the deployment.
DEPLOY_FUSDC_AMOUNT=1000000
DEPLOY_FETH_AMOUNT=1000
DEPLOY_FBTC_AMOUNT=100
